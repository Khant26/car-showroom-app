# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5001
# HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/carshowroom_new
# MONGODB_TIMEOUT_MS=10000

# Authentication (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30d

# CORS: comma-separated list of allowed browser origins (no trailing slash).
# The frontend and /admin dashboard are one app now, so one origin is usually enough.
CORS_ORIGIN=http://localhost:5173
# Legacy names, still honoured:
# FRONTEND_URL=https://your-frontend.example.com
# ADMIN_URL=https://your-admin.example.com

# Uploads (stored on local disk; mount a volume in production)
# UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

# Admin bootstrap (used by `npm run create-admin` / `node seeder.js`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Set to true only temporarily to enable POST /api/auth/admin/create
ALLOW_ADMIN_SETUP=false
