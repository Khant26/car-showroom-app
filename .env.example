# Copy to .env.local (never commit real .env files).
# Base URL of the Car Showroom API, including the /api suffix.
# Used by both the customer site (/) and the admin dashboard (/admin).
# Local backend default:
VITE_API_URL=http://localhost:5001/api
# Production example (replace with your deployed backend URL):
# VITE_API_URL=https://api-carshowroom.khantmaung.com/api
