# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5001
# HOST=0.0.0.0

# Database (Docker example: mongodb://carshowroom:<password>@mongo:27017/carshowroom?authSource=admin)
MONGODB_URI=mongodb://localhost:27017/carshowroom_new
# MONGODB_TIMEOUT_MS=10000

# Authentication (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30d

# CORS: comma-separated list of allowed browser origins (no trailing slash).
# Production: CORS_ORIGIN=https://carshowroom.khantmaung.com
CORS_ORIGIN=http://localhost:5173
# Legacy names, still honoured:
# FRONTEND_URL=https://your-frontend.example.com
# ADMIN_URL=https://your-admin.example.com

# Public base URL of this API. Upload responses return absolute image URLs
# built from it. Production: PUBLIC_URL=https://api-carshowroom.khantmaung.com
# Leave empty locally to return /uploads/... paths.
PUBLIC_URL=

# Uploads (stored on local disk; mount a volume at this path in production)
# UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

# Admin account: created at start-up if no user with ADMIN_EMAIL exists
# (an existing account's password is never changed). Also used by
# `npm run create-admin` (which replaces it) and `npm run seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# ADMIN_NAME=Demo Admin

# Demo data: 1 = insert fictional banners/brands/cars/rentals/sold cars on
# start-up into collections that are still empty (safe to leave on).
SEED_DEMO=0

# Set to true only temporarily to enable POST /api/auth/admin/create
ALLOW_ADMIN_SETUP=false
